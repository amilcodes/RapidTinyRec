  "review": [
    "Context.cpp legacy setter synchronizes CUDA MATMUL TF32/IEEE and HIGH/HIGHEST.",
    "CublasHandlePool.cpp uses that policy for CUBLAS_TF32_TENSOR_OP_MATH unless NoTF32Guard.",
    "Inductor mm.py registers native aten.mm.out and can select other implementations; config and actual generated code/dispatch must be recorded.",
    "CUDABlas.cpp disables TF32 for GEMV; enabling matmul policy does not imply all operations change or accelerate."
  ],
  "limitations": [
    "No GPU candidate result yet.",
    "Precision flag alone is not proof of tensor-core execution.",
    "Kernel names must be linked to cudaGraphLaunch, not merely found in prefill.",
    "No algorithm tuning, layout or backend switch."
  ]
}
